# Copy to deploy/.env on your host. Never commit the populated file.
# No Cloudflare Tunnel token is required: this deployment uses your existing host tunnel.
APP_SECRET_KEY=replace-with-long-random-secret
# Existing Ollama server accessible from inside the StructAgent container.
# Prefer a private LAN or VPN hostname/IP.
OLLAMA_BASE_URL=http://10.0.0.25:11434
OLLAMA_MODEL=gemma4:latest

# Optional authorization for Ollama or its authentication proxy.
# Leave empty or omit entirely if no bearer token is required.
# Enter ONLY the token value (do not prefix it with "Bearer ").
OLLAMA_BEARER_TOKEN=
