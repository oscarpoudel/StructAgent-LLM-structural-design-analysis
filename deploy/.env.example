# Keep this file on the host at deploy/.env. Do not commit secrets.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-tunnel-token
APP_SECRET_KEY=replace-with-long-random-secret
# Existing Ollama GPU server reachable from inside the StructAgent container.
# Use a private IP/VPN hostname, not a public unauthenticated Ollama port.
OLLAMA_BASE_URL=http://10.0.0.25:11434
OLLAMA_MODEL=gemma4:latest
