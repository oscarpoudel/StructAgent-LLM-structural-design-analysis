#!/bin/sh
# Install as root:root mode 0755, never writable by the controller account.
set -eu
cd /opt/structagent/deploy
case "${1:-}" in
  start)
    exec /usr/bin/docker compose --profile compute up -d --no-deps structagent
    ;;
  stop)
    exec /usr/bin/docker compose stop -t 45 structagent
    ;;
  *)
    echo "unsupported action" >&2
    exit 64
    ;;
esac
