# Public demo mode; Cloudflare Access is not required.
# Make sure both HTTPS public origins match your Cloudflare Tunnel routes.
ALLOWED_ORIGINS=https://structagent.oscarp.com.np,https://structagent-app.oscarp.com.np
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# Keep this secret off the public website. Used only for manual administrative Stop.
ADMIN_TOKEN=replace-with-a-long-random-secret
IDLE_SECONDS=1800
MAX_SESSION_SECONDS=7200
START_COOLDOWN_SECONDS=300
