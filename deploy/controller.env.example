# Install as /etc/structagent-controller.env, readable only by root.
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=replace-with-access-application-audience-tag
CF_ALLOWED_EMAILS=you@example.com
ALLOWED_ORIGINS=https://structagent.example.com,https://app.structagent.example.com
IDLE_SECONDS=1800
MAX_SESSION_SECONDS=7200
